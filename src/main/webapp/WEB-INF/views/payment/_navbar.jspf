<%@ page pageEncoding="UTF-8" %>
<%-- Navbar dùng chung cho các trang thanh toán MoMo (copy markup từ cart.jsp, không sửa file gốc) --%>
    <!-- NAVBAR CHUNG -->
    <header class="navbar">
        <div class="navbar__inner">
            <a href="${ctx}/" class="navbar__logo">Fashion<span>.</span></a>

            <form class="navbar__search" action="${ctx}/products" method="get">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input type="text" name="q" placeholder="Tìm kiếm sản phẩm..." value="">
            </form>

            <nav class="navbar__actions">
                <a href="${ctx}/wishlist/toggle" class="navbar__icon-btn" title="Wishlist">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                    </svg>
                </a>
                <a href="${ctx}/cart" class="navbar__icon-btn" title="Giỏ hàng" id="cartNavBtn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                        <line x1="3" y1="6" x2="21" y2="6" />
                        <path d="M16 10a4 4 0 0 1-8 0" />
                    </svg>
                    <c:if test="${not empty cart and cart.totalQuantity > 0}">
                        <span class="navbar__cart-badge" id="cartNavBadge">${cart.totalQuantity}</span>
                    </c:if>
                </a>
                <div class="navbar__divider"></div>
                <c:choose>
                    <c:when test="${not empty sessionScope.user}">
                        <div class="navbar__user-dropdown" id="userDropdown">
                            <button type="button" class="navbar__user-link navbar__user-dropdown-toggle"
                                id="userDropdownBtn" aria-expanded="false" title="Tài khoản">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                                <span id="logoText">
                                    <c:out
                                        value="${not empty sessionScope.user.fullName ? sessionScope.user.fullName : (not empty sessionScope.logoName ? sessionScope.logoName : 'Tài khoản')}" />
                                </span>
                            </button>
                            <div class="navbar__user-menu" id="userMenuPanel">
                                <c:if test="${sessionScope.role == 'ADMIN' || sessionScope.user.role == 'ADMIN'}">
                                    <a href="${ctx}/admin-home.jsp" class="navbar__admin-link">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                                            <rect x="3" y="3" width="7" height="7" />
                                            <rect x="14" y="3" width="7" height="7" />
                                            <rect x="14" y="14" width="7" height="7" />
                                            <rect x="3" y="14" width="7" height="7" />
                                        </svg>
                                        Trang quản trị
                                    </a>
                                </c:if>
                                <a href="${ctx}/profile">Hồ sơ</a>
                                <a href="${ctx}/logout" class="navbar__logout-link">Đăng xuất</a>
                            </div>
                        </div>
                    </c:when>
                    <c:otherwise>
                        <div class="navbar__guest-group">
                            <a href="${ctx}/login" class="navbar__user-link" id="navUserLink" title="Đăng nhập">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                                    <polyline points="10 17 15 12 10 7" />
                                    <line x1="15" y1="12" x2="3" y2="12" />
                                </svg>
                                <span id="logoText">Đăng nhập</span>
                            </a>
                            <span class="navbar__guest-divider">|</span>
                            <a href="${ctx}/register" class="navbar__user-link" id="navRegisterLink" title="Đăng ký tài khoản">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                    <circle cx="8.5" cy="7" r="4" />
                                </svg>
                                <span>Đăng ký</span>
                            </a>
                        </div>
                    </c:otherwise>
                </c:choose>
            </nav>
        </div>
    </header>

    <script>
        (function() {
            var userDropdown = document.getElementById('userDropdown');
            var userDropdownBtn = document.getElementById('userDropdownBtn');
            if (userDropdown && userDropdownBtn) {
                userDropdownBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var isOpen = userDropdown.classList.toggle('is-open');
                    userDropdownBtn.setAttribute('aria-expanded', isOpen);
                });
                document.addEventListener('click', function (e) {
                    if (!userDropdown.contains(e.target)) {
                        userDropdown.classList.remove('is-open');
                        userDropdownBtn.setAttribute('aria-expanded', 'false');
                    }
                });
            }
        })();
    </script>
