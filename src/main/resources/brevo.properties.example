# =====================================================================
# Cấu hình gửi Email qua Brevo (Sendinblue) REST API v3 (Port 443 HTTPS)
# Khắc phục triệt để lỗi chặn cổng SMTP (25, 465, 587) trên Render Free Tier.
#
# Cách 1 (Khuyên dùng khi deploy Render):
# Vào Dashboard của Render -> Web Service -> Environment -> Add Environment Variable:
#   BREVO_API_KEY = your_api_key_from_brevo_dashboard
#   BREVO_SENDER_EMAIL = your_email@gmail.com (Email đã kích hoạt trên Brevo)
#   BREVO_SENDER_NAME = Fashion Shop
#
# Cách 2 (Khi chạy local / dev):
# Copy file này thành "brevo.properties" trong cùng thư mục src/main/resources/
# và điền các giá trị dưới đây:
# =====================================================================

brevo.apiKey=YOUR_BREVO_API_KEY_HERE
brevo.senderEmail=anhhaduy1906@gmail.com
brevo.senderName=Fashion Shop
