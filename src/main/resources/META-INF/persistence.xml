<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="ClothingWebPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- Cấu hình Driver -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect" />

            <!-- Cấu hình PostgreSQL JDBC Connection -->
            <!-- <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/clothing_web" />
            <property name="jakarta.persistence.jdbc.user" value="postgres" />
            <property name="jakarta.persistence.jdbc.password" value="huy-070306" /> -->

            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://ep-round-poetry-aoukdlam.c-2.ap-southeast-1.aws.neon.tech/clothing_web_db?sslmode=require" />
            <property name="jakarta.persistence.jdbc.user" value="clothing_web_db_owner" />
            <property name="jakarta.persistence.jdbc.password" value="npg_nAgZa15WlKbr" />

            <!-- Cấu hình HikariCP (Connection Pool) -->
            <property name="hibernate.hikari.connectionTimeout" value="20000"/>
            <property name="hibernate.hikari.minimumIdle" value="2"/>
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>

            <!-- Cấu hình Hibernate -->
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
            
            <!-- Quản lý Schema dùng Update -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>
</persistence>